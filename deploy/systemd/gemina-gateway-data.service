# Stage-2 data + exit gateway (container).
#
# Validated on the Oracle Cloud arm64 host during WS-F, 2026-09-25 (Vikunja
# #2609 / GitHub issue #5). Unlike gemina-gateway.service (probe mode), this
# runs the real authenticated handshake + encrypted data plane and the internet
# exit path, so it needs host networking, /dev/net/tun and a writable identity
# volume.
#
# Least privilege (issue #5): Docker never puts an added capability into the
# effective set of a NON-root container user, so `--cap-add NET_ADMIN` on the
# image's :nonroot uid (65532) cannot open/configure the TUN. Instead the
# container starts as uid 0 holding ONLY NET_ADMIN + SETUID + SETGID (every other
# capability dropped); cmd/gateway opens the UDP socket and the TUN fd, then
# setgroups/setgid/setuid to GEMINA_GATEWAY_RUN_AS (65532:65532) — which clears
# every capability — and verifies it cannot regain root before it loads the
# identity or reads a single datagram. no-new-privileges blocks re-escalation via
# exec; the root filesystem is read-only (only the identity volume is writable).
#
# Host provisioning (ip_forward, persistent TUN gemina0 + addr + MTU, MASQUERADE,
# DOCKER-USER forward accepts) is scripts/setup-exit-host.sh, re-run as
# ExecStartPre on every start so a reboot or docker restart cannot leave the
# host half-configured. The image is gemina-gateway:latest, built by
# scripts/deploy-dev-gateway.sh (GATEWAY_UNIT=gemina-gateway-data.service).

[Unit]
Description=gemina Stage-2 data + exit gateway (container)
Documentation=https://github.com/joanmarcriera/gemina
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
# Both units bind the same UDP port: never run them together.
Conflicts=gemina-gateway.service

[Service]
Environment=GATEWAY_PORT=51820
Environment=DEDUP_CAPACITY=8192
Environment=LOG_LEVEL=info
Environment=POOL=10.99.0.0/16
Environment=STATE_DIR=/var/lib/gemina
Environment=RUN_AS=65532:65532
# Empty = setup-exit-host.sh uses the default-route interface.
Environment=WAN_IF=
# Idempotent host setup (see header). Runs as root on the host, outside the
# container. scripts/deploy-dev-gateway.sh installs scripts/setup-exit-host.sh
# to /usr/local/sbin (bin_t under SELinux, and immune to the /opt/gemina rsync).
ExecStartPre=/usr/bin/env POOL=${POOL} STATE_DIR=${STATE_DIR} WAN_IF=${WAN_IF} \
  /usr/local/sbin/gemina-setup-exit-host
ExecStartPre=-/usr/bin/docker rm -f gemina-gateway-data
# --user 0:0 + --cap-drop ALL + three --cap-add: privileged only until the
#   in-process drop (see header). SETUID/SETGID exist solely to perform it.
# --network host: gemina0 lives in the host netns where the MASQUERADE rule
#   applies; the listener binds host UDP.
# --device /dev/net/tun: attach the persistent TUN device.
# -v STATE_DIR: persist the Ed25519 identity so the pinned public key is stable
#   across restarts (a new key would break every client's pin). Owned by the
#   RUN_AS uid; it is only opened after the drop.
ExecStart=/usr/bin/docker run --rm --name gemina-gateway-data \
  --user 0:0 \
  --cap-drop ALL \
  --cap-add NET_ADMIN \
  --cap-add SETUID \
  --cap-add SETGID \
  --security-opt no-new-privileges \
  --read-only \
  --network host \
  --device /dev/net/tun \
  -v ${STATE_DIR}:/var/lib/gemina \
  -e GEMINA_GATEWAY_MODE=data \
  -e GEMINA_GATEWAY_EXIT=on \
  -e GEMINA_GATEWAY_RUN_AS=${RUN_AS} \
  -e GEMINA_GATEWAY_ADDR=:${GATEWAY_PORT} \
  -e GEMINA_GATEWAY_IDENTITY=/var/lib/gemina/gateway-identity.key \
  -e GEMINA_GATEWAY_POOL=${POOL} \
  -e GEMINA_GATEWAY_TUN=gemina0 \
  -e GEMINA_GATEWAY_DEDUP_CAPACITY=${DEDUP_CAPACITY} \
  -e GEMINA_GATEWAY_LOG_LEVEL=${LOG_LEVEL} \
  gemina-gateway:latest
ExecStop=/usr/bin/docker stop gemina-gateway-data
Restart=always
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
